    {
      "name": "02 - Users (Read)",
      "item": [
        {
          "name": "Get All Users - Page 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Response has pagination metadata', function () {",
                  "    pm.expect(json).to.have.property('page', 1);",
                  "    pm.expect(json).to.have.property('per_page');",
                  "    pm.expect(json).to.have.property('total');",
                  "    pm.expect(json).to.have.property('total_pages');",
                  "});",
                  "",
                  "pm.test('Users array is not empty', function () {",
                  "    pm.expect(json.data).to.be.an('array').that.is.not.empty;",
                  "});",
                  "",
                  "pm.test('Each user has required fields', function () {",
                  "    json.data.forEach(function (user) {",
                  "        pm.expect(user).to.have.property('id');",
                  "        pm.expect(user).to.have.property('email');",
                  "        pm.expect(user).to.have.property('first_name');",
                  "        pm.expect(user).to.have.property('last_name');",
                  "        pm.expect(user).to.have.property('avatar');",
                  "    });",
                  "});",
                  "",
                  "const firstUserId = json.data[0].id;",
                  "pm.environment.set('userId', firstUserId);",
                  "pm.collectionVariables.set('userId', firstUserId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
