{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
    "name": "ReqRes API Automation POC",
    "description": "Practical API automation POC for QA engineers.\n\nCovers:\n- CRUD operations\n- Authentication flow\n- Response assertions (status, body, schema, performance)\n- Variable chaining between requests\n- Negative / edge-case tests\n- Data-driven user creation (use with Newman + CSV)\n\nTarget API: https://reqres.in (free public REST API for testing)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "if (pm.request.method !== 'GET' && pm.request.method !== 'DELETE') {",
          "    pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
          "}",
          "const apiKey = pm.environment.get('apiKey');",
          "if (apiKey) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + apiKey });",
          "}",
          "pm.collectionVariables.set('requestTimestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const maxTime = parseInt(pm.environment.get('maxResponseTimeMs') || '3000', 10);",
          "",
          "pm.test('Response time is within SLA', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(maxTime);",
          "});",
          "",
          "if (pm.response.code !== 204) {",
          "    pm.test('Content-Type is JSON', function () {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    });",
          "}"
        ]
      }
    }
  ],
