    {
      "name": "03 - Users (Write)",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueName = pm.variables.replaceIn('{{$randomFirstName}}');",
                  "const uniqueJob = pm.variables.replaceIn('{{$randomJobTitle}}');",
                  "pm.collectionVariables.set('createdUserName', uniqueName);",
                  "pm.variables.set('dynamicName', uniqueName);",
                  "pm.variables.set('dynamicJob', uniqueJob);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Created user echoes request payload', function () {",
                  "    pm.expect(json.name).to.eql(pm.collectionVariables.get('createdUserName'));",
                  "    pm.expect(json).to.have.property('job');",
                  "});",
                  "",
                  "pm.test('Created user has id and createdAt', function () {",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('createdAt');",
                  "});",
                  "",
                  "pm.environment.set('userId', json.id);",
                  "pm.collectionVariables.set('userId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{dynamicName}}\",\n  \"job\": \"{{dynamicJob}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            },
            "description": "Creates a user with dynamic data. Stores returned ID for update/delete."
          },
          "response": []
